### docker ---------------------------------------
CONFIG_PACKAGE_podman=m
CONFIG_PACKAGE_luci-app-podman=m

# ========== Podman 核心依赖与硬件加速 (R3D 专用) ==========
# 1. 硬件浮点与多媒体加速 (必须，防止容器应用崩溃)
CONFIG_VFP=y
CONFIG_VFPv3=y
CONFIG_NEON=y

# 2. 容器资源隔离与安全 (强烈建议，确保 podman 命令完整)
CONFIG_CGROUP_DEVICE=y          # 限制容器访问宿主机设备，安全项
CONFIG_CGROUP_CPUACCT=y         # 支持 podman stats 查看 CPU
CONFIG_CGROUP_FREEZER=y         # 支持 podman pause 暂停容器
CONFIG_DEVPTS_MULTIPLE_INSTANCES=y # 容器终端隔离
CONFIG_MEMCG_SWAP_ENABLED=y     # 允许限制内存+Swap总量
CONFIG_POSIX_MQUEUE=y           # 提升部分 systemd 镜像兼容性

# 3. 网络识别 (可选，建议开启以支持未来 QoS)
CONFIG_NET_CLS_CGROUP=y

# ----------------------------------------

# batman 和 mesh
CONFIG_PACKAGE_wpad-openssl=y
CONFIG_PACKAGE_kmod-cfg80211=y
CONFIG_PACKAGE_kmod-mac80211=y

CONFIG_PACKAGE_luci-app-meshwizard=y  # Mesh 配置向导
CONFIG_PACKAGE_dawn=y                 # 自动漫游（多节点 Mesh 推荐）
CONFIG_PACKAGE_luci-app-dawn=y
CONFIG_PACKAGE_luci-i18n-dawn-zh-cn=y

CONFIG_PACKAGE_luci-app-netspeedtest=y
CONFIG_PACKAGE_luci-i18n-netspeedtest-zh-cn=y

CONFIG_PACKAGE_tcpdump-mini=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_iwinfo=y

CONFIG_PACKAGE_luci-lib-iwinfo=y
CONFIG_PACKAGE_rpcd-mod-iwinfo=y
