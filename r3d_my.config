### docker ---------------------------------------
CONFIG_PACKAGE_dockerd=m
CONFIG_PACKAGE_docker=m
CONFIG_PACKAGE_containerd=m
CONFIG_PACKAGE_runc=m
CONFIG_PACKAGE_libnetwork=m
CONFIG_PACKAGE_luci-app-dockerman=m
CONFIG_PACKAGE_luci-i18n-dockerman-zh-cn=m

# docker 资源隔离
CONFIG_CGROUPS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_PIDS=y
CONFIG_BLK_CGROUP=y
CONFIG_MEMCG=y
CONFIG_MEMCG_SWAP=y

# docker 命名空间
CONFIG_NAMESPACES=y
CONFIG_NET_NS=y
CONFIG_PID_NS=y
CONFIG_IPC_NS=y
CONFIG_UTS_NS=y
CONFIG_MNT_NS=y

# docker 网络
CONFIG_NETFILTER=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CONNTRACK_IPV4=y
CONFIG_NF_NAT=y
CONFIG_NF_NAT_IPV4=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_VETH=y
CONFIG_BRIDGE=y
# 推荐开启
CONFIG_BRIDGE_NETFILTER=y
# 可选
# CONFIG_TUN is not set

# docker 存储（Docker 默认 overlay2）
CONFIG_OVERLAY_FS=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y

# 基础
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
# 缓存（默认不配就是启用）
CONFIG_SECCOMP_CACHE_AVOID=y

CONFIG_KEYS=y

# ----------------------------------------

# batman 和 mesh
CONFIG_PACKAGE_wpad-openssl=y
CONFIG_PACKAGE_kmod-cfg80211=y
CONFIG_PACKAGE_kmod-mac80211=y

CONFIG_PACKAGE_luci-app-meshwizard=y  # Mesh 配置向导
CONFIG_PACKAGE_dawn=y                 # 自动漫游（多节点 Mesh 推荐）
CONFIG_PACKAGE_luci-app-dawn=y
CONFIG_PACKAGE_luci-i18n-dawn-zh-cn=y

CONFIG_PACKAGE_luci-app-netspeedtest=y
CONFIG_PACKAGE_luci-i18n-netspeedtest-zh-cn=y

CONFIG_PACKAGE_tcpdump-mini=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_iwinfo=y

CONFIG_PACKAGE_luci-lib-iwinfo=y
CONFIG_PACKAGE_rpcd-mod-iwinfo=y
